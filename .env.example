# --- Database (Postgres with pgvector extension) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/research_deck

# --- Redis (BullMQ job queue) ---
REDIS_URL=redis://localhost:6379

# --- Google Gemini — used for slide synthesis, multi-query generation, AND
# embeddings (gemini-embedding-001, output pinned to 1536 dims via
# outputDimensionality to match db/schema.sql). Free tier, no card required:
# https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Voyage AI — cross-encoder reranking of retrieved chunks against the
# topic. Get a key at https://dashboard.voyageai.com/ ---
VOYAGE_API_KEY=
VOYAGE_RERANK_MODEL=rerank-2-lite

# --- Emails exempt from the one-free-generation gate in
# app/api/generate/route.ts, comma-separated (e.g. the project owner's own
# address, for testing/demoing) ---
UNLIMITED_EMAILS=

# --- OpenAlex API ---
# Fully open, no API key needed. Optional: setting a contact email joins
# OpenAlex's "polite pool" for faster, more consistent rate limits.
OPENALEX_MAILTO=

# --- Local file storage for generated decks ---
# In production, swap lib/storage.ts's implementation for Vercel Blob or S3.
GENERATED_DIR=./generated

# --- Python executable used by the worker to run scripts/build_deck.py ---
PYTHON_BIN=python
